<!DOCTYPE html>  
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Meli's Prive Variety Store</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --pink: #e91e63;    
      --pink-light: #fce4ec;  #fc
      --bg: #fff5f8;
      --dark: #2d2d2d;
      --gray: #666;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Poppins', sans-serif;
      background: var(--bg);
      color: var(--dark);
      padding-bottom: 75px;
      min-height: 100vh;
    }
    h1,h2,h3 { font-family: 'Playfair Display', serif; }

    /* TOP BAR */
    .topbar {
      background: white;
      padding: 14px 16px 10px;
      text-align: center;
      box-shadow: 0 2px 12px rgba(233,30,99,0.1);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .topbar .store-name {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--pink);
    }
    .topbar .tagline {
      font-size: 0.78rem;
      color: var(--gray);
      margin-top: 2px;
    }

    /* PAGES */
    .page { display: none; padding: 16px; }
    .page.active { display: block; }

    /* HERO */
    .hero-box {
      background: white;
      border-radius: 18px;
      padding: 22px 18px;
      text-align: center;
      box-shadow: 0 4px 20px rgba(233,30,99,0.08);
      margin-bottom: 22px;
    }
    .hero-box h1 {
      font-size: 1.5rem;
      line-height: 1.3;
      margin-bottom: 10px;
    }
    .hero-box h1 span { color: var(--pink); }
    .hero-box p {
      font-size: 0.9rem;
      color: var(--gray);
      margin-bottom: 18px;
    }
    .btn-row {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn {
      background: var(--pink);
      color: white;
      border: none;
      padding: 11px 18px;
      border-radius: 30px;
      font-size: 0.88rem;
      font-weight: 500;
      cursor: pointer;
    }
    .btn-outline {
      background: transparent;
      border: 2px solid var(--pink);
      color: var(--pink);
    }

    /* SECTION */
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 22px 0 14px;
    }
    .section-header h2 { font-size: 1.25rem; }
    .see-all {
      color: var(--pink);
      font-size: 0.85rem;
      font-weight: 500;
    }

    /* PRODUCTS */
    .products-scroll {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      padding-bottom: 8px;
    }
    .product-card {
      background: white;
      border-radius: 16px;
      min-width: 155px;
      width: 155px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.06);
      overflow: hidden;
      flex-shrink: 0;
    }
    .product-img {
      height: 115px;
      background: var(--pink-light);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.6rem;
      position: relative;
    }
    .product-info { padding: 12px; }
    .product-info h3 {
      font-size: 0.92rem;
      font-family: 'Poppins', sans-serif;
      font-weight: 500;
      margin-bottom: 4px;
    }
    .price { color: var(--pink); font-weight: 600; font-size: 1rem; }
    .add-btn {
      position: absolute;
      bottom: 8px;
      right: 8px;
      width: 32px;
      height: 32px;
      background: var(--pink);
      color: white;
      border: none;
      border-radius: 50%;
      font-size: 1.3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    /* COMMENTS */
    .comments-box {
      background: white;
      border-radius: 16px;
      padding: 16px;
      margin: 20px 0;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
    .comment {
      padding: 10px 0;
      border-bottom: 1px solid #f0f0f0;
      font-size: 0.9rem;
    }
    .comment:last-child { border-bottom: none; }
    .comment strong { color: var(--pink); }

    /* CATEGORIES */
    .cat-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .cat-box {
      background: white;
      border-radius: 14px;
      padding: 16px 10px;
      text-align: center;
      box-shadow: 0 3px 12px rgba(0,0,0,0.05);
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
    }

    /* CARD */
    .card {
      background: white;
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 14px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.05);
    }

    /* BOTTOM NAV */
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: white;
      display: flex;
      justify-content: space-around;
      padding: 10px 0 14px;
      box-shadow: 0 -3px 15px rgba(0,0,0,0.1);
      z-index: 200;
    }
    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 0.7rem;
      color: #888;
      background: none;
      border: none;
      font-family: inherit;
      cursor: pointer;
    }
    .nav-item.active { color: var(--pink); }
    .nav-item span { font-size: 1.35rem; margin-bottom: 2px; }

    /* FLOAT BUTTONS */
    .float-btn {
      position: fixed;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      z-index: 150;
      border: none;
      box-shadow: 0 4px 15px rgba(0,0,0,0.2);
      cursor: pointer;
    }
    .whatsapp { bottom: 90px; right: 16px; background: #25d366; color: white; }
    .chat-btn { bottom: 90px; left: 16px; background: var(--pink); color: white; }

    /* CHAT BOX */
    .chat-box {
      position: fixed;
      bottom: 155px;
      left: 16px;
      width: 300px;
      max-width: 85vw;
      background: white;
      border-radius: 16px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.15);
      display: none;
      flex-direction: column;
      overflow: hidden;
      z-index: 300;
    }
    .chat-box.active { display: flex; }
    .chat-header {
      background: var(--pink);
      color: white;
      padding: 12px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 500;
    }
    .chat-header button { background: none; border: none; color: white; font-size: 1.3rem; }
    .chat-messages { height: 200px; padding: 12px; overflow-y: auto; background: #fafafa; }
    .msg { margin-bottom: 10px; max-width: 80%; font-size: 0.9rem; }
    .msg.bot { background: white; padding: 8px 12px; border-radius: 12px 12px 12px 4px; }
    .msg.user { background: var(--pink-light); padding: 8px 12px; border-radius: 12px 12px 4px 12px; margin-left: auto; }
    .chat-input { display: flex; border-top: 1px solid #eee; }
    .chat-input input { flex: 1; border: none; padding: 12px; outline: none; font-family: inherit; }
    .chat-input button { background: var(--pink); color: white; border: none; padding: 0 14px; }

    /* FORM */
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-size: 0.85rem; margin-bottom: 5px; }
    .form-group input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #ddd;
      border-radius: 10px;
      font-size: 1rem;
      font-family: inherit;
    }
    .payment-box {
      background: var(--pink-light);
      border-radius: 14px;
      padding: 18px;
      margin-top: 16px;
      font-size: 0.95rem;
    }
    .admin-menu {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .admin-btn {
      background: white;
      border: none;
      border-radius: 14px;
      padding: 20px 12px;
      text-align: center;
      font-weight: 500;
      box-shadow: 0 3px 12px rgba(0,0,0,0.06);
      cursor: pointer;
      font-size: 0.9rem;
    }
    .story-text p {
      margin-bottom: 14px;
      color: var(--gray);
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .empty-cart {
      text-align: center;
      padding: 40px 20px;
      color: var(--gray);
    }
  </style>
</head>
